{
  "name": "pi-context-hint",
  "version": "0.2.0",
  "description": "Persistent Project, Session, and Turn context cards for the Pi coding agent.",
  "keywords": [
    "pi-package",
    "pi",
    "context",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thonean/pi-context-hint.git"
  },
  "homepage": "https://github.com/thonean/pi-context-hint#readme",
  "bugs": {
    "url": "https://github.com/thonean/pi-context-hint/issues"
  },
  "author": "thonean",
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions/context-hint.ts",
    "src/core.ts",
    "README.md",
    "LICENSE",
    "assets/context-hint-logo.svg",
    "assets/context-hint-still.png"
  ],
  "pi": {
    "image": "https://cdn.jsdelivr.net/npm/pi-context-hint@0.2.0/assets/context-hint-still.png",
    "extensions": [
      "extensions/context-hint.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build extensions/context-hint.ts --outfile dist/context-hint.js --target node --format esm --external @earendil-works/pi-ai --external @earendil-works/pi-coding-agent --external @earendil-works/pi-tui",
    "pack:preview": "npm pack --dry-run",
    "check": "bun test && bun run typecheck && bun run build && npm pack --dry-run",
    "package:smoke": "bun run build && bun scripts/package-check.ts",
    "release:check": "bun run check && bun scripts/package-check.ts --release",
    "prepublishOnly": "bun run release:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.1.0",
    "@earendil-works/pi-coding-agent": ">=1.1.0",
    "@earendil-works/pi-tui": ">=1.1.0"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22.19.0"
  }
}
